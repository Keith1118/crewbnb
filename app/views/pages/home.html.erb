<% content_for(:title, "Crewbase — Accommodation for working crews in Ireland") %>
<% meta_description "Tell us where your crew is working and we'll come back with accommodation that suits — weekday pricing, beds and parking, a proper invoice for every stay. Email us or send your requirements." %>

<%# ===== HERO — pitch on the left, enquiry form on the right ===== %>
<section class="bg-[#0F224F] pt-10 pb-16">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">

      <div>
        <p class="text-blue-200/60 text-sm font-medium mb-3">For companies housing teams in Ireland</p>
        <h1 class="font-headline text-3xl md:text-4xl font-extrabold text-white leading-[1.1] tracking-tight mb-4">
          Tell us where the crew is working. We'll sort the beds.
        </h1>
        <p class="text-blue-200/80 text-base md:text-lg mb-8">
          Send us your dates, location and team size. We come back with accommodation that suits the job — weekday pricing, parking, and a proper invoice every time.
        </p>

        <div class="space-y-3 mb-8">
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-400 text-lg mt-0.5">check_circle</span>
            <p class="text-blue-100 text-sm"><strong class="text-white">One email, not ten listings</strong> — we do the searching</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-400 text-lg mt-0.5">check_circle</span>
            <p class="text-blue-100 text-sm"><strong class="text-white">Weekday rates</strong> — stop paying weekend prices for weekday work</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-400 text-lg mt-0.5">check_circle</span>
            <p class="text-blue-100 text-sm"><strong class="text-white">A proper invoice</strong> — every stay, no chasing</p>
          </div>
        </div>

        <p class="text-blue-200/70 text-sm">
          Prefer email?
          <%= mail_to contact_email, contact_email, subject: "Accommodation enquiry",
              class: "text-white font-semibold underline underline-offset-4 hover:text-blue-100 transition-colors" %>
        </p>

        <%# Built for — immediate self-identification %>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-8 text-sm text-blue-200/60">
          <span>Built for:</span>
          <span class="text-white font-medium">Construction crews</span>
          <span class="text-blue-300/30">&bull;</span>
          <span class="text-white font-medium">Business teams</span>
          <span class="text-blue-300/30">&bull;</span>
          <span class="text-white font-medium">Engineers &amp; contractors</span>
          <span class="text-blue-300/30">&bull;</span>
          <span class="text-white font-medium">Film &amp; production</span>
          <span class="text-blue-300/30">&bull;</span>
          <span class="text-white font-medium">Any crew on the road</span>
        </div>
      </div>

      <%# Enquiry form %>
      <div id="enquiry" class="bg-white rounded-2xl p-6 md:p-8 shadow-xl scroll-mt-24">
        <h2 class="font-headline text-xl font-bold text-slate-900 mb-1">Send us your requirements</h2>
        <p class="text-slate-500 text-sm mb-6">We reply within 24 hours, usually quicker.</p>

        <%= form_with(model: @enquiry, url: enquiries_path, scope: :enquiry, class: "space-y-4") do |f| %>
          <% if @enquiry.errors.any? %>
            <div class="bg-error-container/30 border border-error/20 rounded-xl p-4">
              <p class="text-sm font-medium text-error mb-2">Please fix the following:</p>
              <ul class="list-disc list-inside text-sm text-error/80 space-y-1">
                <% @enquiry.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :company, "Company", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <%= f.text_field :company, placeholder: "Murphy Contracts Ltd",
                  class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#0F224F]/20 focus:border-[#0F224F] transition-colors" %>
            </div>
            <div>
              <%= f.label :name, "Your name", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <%= f.text_field :name, placeholder: "John Murphy",
                  class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#0F224F]/20 focus:border-[#0F224F] transition-colors" %>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :email, "Email", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <%= f.email_field :email, placeholder: "john@company.ie",
                  class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#0F224F]/20 focus:border-[#0F224F] transition-colors" %>
            </div>
            <div>
              <%= f.label :phone, "Phone (optional)", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <%= f.telephone_field :phone, placeholder: "087 123 4567",
                  class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#0F224F]/20 focus:border-[#0F224F] transition-colors" %>
            </div>
          </div>

          <div>
            <%= f.label :location, "Where's the job?", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= f.text_field :location, placeholder: "Town or county in Ireland",
                class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#0F224F]/20 focus:border-[#0F224F] transition-colors" %>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :dates, "Dates", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <%= f.text_field :dates, placeholder: "Mon–Fri from 12 Oct, 6 weeks",
                  class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#0F224F]/20 focus:border-[#0F224F] transition-colors" %>
            </div>
            <div>
              <%= f.label :crew_size, "How many people?", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <%= f.number_field :crew_size, min: 1, placeholder: "4",
                  class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#0F224F]/20 focus:border-[#0F224F] transition-colors" %>
            </div>
          </div>

          <div>
            <%= f.label :details, "Anything else?", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= f.text_area :details, rows: 4, placeholder: "Parking for two vans, laundry, close to the site in Arklow…",
                class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#0F224F]/20 focus:border-[#0F224F] transition-colors resize-none" %>
          </div>

          <%= render "shared/spam_protection" %>

          <%= f.submit "Send enquiry", data: { turbo_submits_with: "Sending…" },
              class: "w-full bg-[#0F224F] text-white px-8 py-3 rounded-xl font-semibold text-sm hover:bg-[#002d75] transition-colors cursor-pointer" %>

          <p class="text-xs text-slate-400 text-center">
            No account needed. We only use your details to answer this enquiry.
          </p>
        <% end %>
      </div>

    </div>
  </div>
</section>

<%# ===== SAVINGS BAR ===== %>
<section class="bg-green-50 border-b border-green-100">
  <div class="max-w-screen-xl mx-auto px-6 py-3 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
    <div class="flex items-center gap-1.5 text-green-800 font-semibold">
      <span class="material-symbols-outlined text-lg">savings</span>
      Save 10–25% with weekday-only pricing
    </div>
    <span class="hidden md:inline text-green-300">|</span>
    <div class="flex items-center gap-1.5 text-green-800 font-medium">
      <span class="material-symbols-outlined text-lg">receipt_long</span>
      Automatic invoices, less admin
    </div>
    <span class="hidden md:inline text-green-300">|</span>
    <div class="flex items-center gap-1.5 text-green-800 font-medium">
      <span class="material-symbols-outlined text-lg">schedule</span>
      Answer within 24 hours
    </div>
  </div>
</section>

<%# ===== OUR PROPERTIES ===== %>
<section id="our-properties" class="bg-white py-16 scroll-mt-20">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="flex items-center justify-between mb-2">
      <h2 class="font-headline text-2xl font-bold text-slate-900">Properties</h2>
      <%= link_to properties_path, class: "inline-flex items-center gap-1 text-sm font-semibold text-[#0F224F] hover:underline" do %>
        Browse all
        <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
      <% end %>
    </div>
    <p class="text-slate-500 text-sm mb-8">A sample of the places we put crews in. Tell us the location and we'll find what fits.</p>

    <% if @properties.present? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @properties.each do |property| %>
          <%= render "properties/property_card", property: property %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-20">
        <span class="material-symbols-outlined text-slate-300 text-5xl mb-4">search_off</span>
        <p class="text-slate-500">No properties listed yet. Check back soon.</p>
      </div>
    <% end %>
  </div>
</section>

<%# ===== HOW IT WORKS ===== %>
<section id="how-it-works" class="bg-slate-50 py-16 border-t border-slate-100 scroll-mt-20">
  <div class="max-w-screen-xl mx-auto px-6">
    <h2 class="font-headline text-2xl font-bold text-slate-900 text-center mb-12">How it works</h2>

    <div class="grid grid-cols-1 md:grid-cols-7 gap-0 max-w-4xl mx-auto">
      <div class="text-center px-3">
        <div class="w-10 h-10 rounded-full bg-[#0F224F] text-white text-sm font-bold flex items-center justify-center mx-auto mb-3">1</div>
        <p class="font-semibold text-slate-900 text-sm mb-1">Send your requirements</p>
        <p class="text-slate-500 text-xs leading-relaxed">Location, dates, how many people, anything the crew needs.</p>
      </div>

      <div class="hidden md:flex items-center justify-center">
        <span class="material-symbols-outlined text-slate-300 text-lg">arrow_forward</span>
      </div>

      <div class="text-center px-3 mt-6 md:mt-0">
        <div class="w-10 h-10 rounded-full bg-[#0F224F] text-white text-sm font-bold flex items-center justify-center mx-auto mb-3">2</div>
        <p class="font-semibold text-slate-900 text-sm mb-1">We come back with options</p>
        <p class="text-slate-500 text-xs leading-relaxed">Stays near the site with a setup that suits — beds, parking, laundry.</p>
      </div>

      <div class="hidden md:flex items-center justify-center">
        <span class="material-symbols-outlined text-slate-300 text-lg">arrow_forward</span>
      </div>

      <div class="text-center px-3 mt-6 md:mt-0">
        <div class="w-10 h-10 rounded-full bg-[#0F224F] text-white text-sm font-bold flex items-center justify-center mx-auto mb-3">3</div>
        <p class="font-semibold text-slate-900 text-sm mb-1">You pick, we confirm</p>
        <p class="text-slate-500 text-xs leading-relaxed">Keys sorted, parking sorted, everything ready for check-in.</p>
      </div>

      <div class="hidden md:flex items-center justify-center">
        <span class="material-symbols-outlined text-slate-300 text-lg">arrow_forward</span>
      </div>

      <div class="text-center px-3 mt-6 md:mt-0">
        <div class="w-10 h-10 rounded-full bg-green-600 text-white text-sm font-bold flex items-center justify-center mx-auto mb-3">4</div>
        <p class="font-semibold text-slate-900 text-sm mb-1">Invoice sent automatically</p>
        <p class="text-slate-500 text-xs leading-relaxed">A proper invoice for every stay — no chasing needed.</p>
      </div>
    </div>
  </div>
</section>

<%# ===== COST COMPARISON ===== %>
<section class="bg-white py-16">
  <div class="max-w-screen-xl mx-auto px-6">
    <p class="text-slate-400 text-xs text-center uppercase tracking-wider font-semibold mb-3">Typical 3-person crew, 1 working week</p>
    <h2 class="font-headline text-2xl font-bold text-slate-900 text-center mb-2">You're overpaying. Here's the maths.</h2>
    <p class="text-slate-500 text-center mb-10 text-sm">Wicklow area. Real numbers.</p>

    <div class="max-w-lg mx-auto">
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100 text-center">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Airbnb / Booking.com</p>
          <p class="text-3xl font-bold text-slate-300 line-through">&euro;800</p>
          <div class="mt-3 space-y-1">
            <p class="text-sm text-slate-400">7-night minimum</p>
            <p class="text-sm text-slate-400">No proper invoice</p>
            <p class="text-sm text-slate-400">1–2 beds, no parking</p>
          </div>
        </div>
        <div class="bg-green-50 rounded-2xl p-6 border-2 border-green-200 text-center relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="bg-green-600 text-white text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap">Save &euro;160/week</span>
          </div>
          <p class="text-xs font-semibold text-green-700 uppercase tracking-wider mb-3">Crewbase</p>
          <p class="text-3xl font-bold text-green-700">&euro;640</p>
          <div class="mt-3 space-y-1">
            <p class="text-sm text-green-700 font-medium">Mon–Fri pricing</p>
            <p class="text-sm text-green-700 font-medium">Automatic invoice</p>
            <p class="text-sm text-green-700 font-medium">4 beds + parking</p>
          </div>
        </div>
      </div>
      <p class="text-center text-xs text-slate-400 mt-4">Based on average Wicklow listings. Your savings will vary.</p>
    </div>
  </div>
</section>

<%# ===== FOR BUSINESSES / FOR HOSTS — outcome-focused ===== %>
<section class="bg-slate-50 py-16 border-t border-slate-100">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <%# Businesses %>
      <div class="bg-white rounded-2xl p-8 border border-slate-100">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4">Housing a team?</p>
        <h2 class="font-headline text-xl font-bold text-slate-900 mb-5">Stop booking work trips on Airbnb.</h2>
        <div class="space-y-4">
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-600 text-lg mt-0.5">check_circle</span>
            <p class="text-slate-700 text-sm"><strong>Cut costs 10–25%</strong> — weekday rates, not tourist rates</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-600 text-lg mt-0.5">check_circle</span>
            <p class="text-slate-700 text-sm"><strong>Automatic invoices, less admin</strong> — every stay includes a proper invoice</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-600 text-lg mt-0.5">check_circle</span>
            <p class="text-slate-700 text-sm"><strong>Beds, parking, laundry</strong> — not hot tubs</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-600 text-lg mt-0.5">check_circle</span>
            <p class="text-slate-700 text-sm"><strong>One point of contact</strong> — send the requirements once, we handle the rest</p>
          </div>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <%= link_to root_path(anchor: "enquiry"), class: "inline-flex items-center gap-1.5 bg-[#0F224F] text-white px-5 py-2.5 rounded-xl font-semibold text-sm hover:bg-[#002d75] transition-colors" do %>
            Send an enquiry
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          <% end %>
          <%= mail_to contact_email, "Or email us", subject: "Accommodation enquiry",
              class: "text-sm font-semibold text-[#0F224F] hover:underline" %>
        </div>
      </div>

      <%# Hosts %>
      <div class="bg-[#0F224F] rounded-2xl p-8">
        <p class="text-xs font-semibold text-blue-200/70 uppercase tracking-wider mb-4">Got a spare property?</p>
        <h2 class="font-headline text-xl font-bold text-white mb-5">Your place sits empty Mon–Fri. Fix that.</h2>
        <div class="space-y-4">
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-400 text-lg mt-0.5">check_circle</span>
            <p class="text-blue-100 text-sm"><strong class="text-white">Earn from empty weekdays</strong> — contractors book weeks or months</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-400 text-lg mt-0.5">check_circle</span>
            <p class="text-blue-100 text-sm"><strong class="text-white">No off-season</strong> — crews work through the winter, when tourist bookings dry up</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-400 text-lg mt-0.5">check_circle</span>
            <p class="text-blue-100 text-sm"><strong class="text-white">Professional guests</strong> — comfortable accommodation for hard workers who eat, sleep, and work</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-400 text-lg mt-0.5">check_circle</span>
            <p class="text-blue-100 text-sm"><strong class="text-white">Repeat bookings</strong> — projects run for weeks, not weekends</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="material-symbols-outlined text-green-400 text-lg mt-0.5">check_circle</span>
            <p class="text-blue-100 text-sm"><strong class="text-white">Automatic invoices, less admin</strong> — every booking includes a proper invoice</p>
          </div>
        </div>
        <div class="mt-6">
          <%= link_to new_user_registration_path(role: "host"), class: "inline-flex items-center gap-1.5 bg-white text-[#0F224F] px-5 py-2.5 rounded-xl font-semibold text-sm hover:bg-blue-50 transition-colors" do %>
            List your property
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</section>

<%# ===== TRUST — real, not corporate ===== %>
<section class="bg-white py-16 border-t border-slate-100">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="max-w-2xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 bg-slate-100 rounded-full px-4 py-1.5 text-xs font-semibold text-slate-600 mb-6">
        <span class="material-symbols-outlined text-base">location_on</span>
        Made in Ireland
      </div>
      <p class="text-slate-700 text-lg leading-relaxed mb-4">
        We started this because we <em>are</em> the hosts.
      </p>
      <p class="text-slate-500 text-sm leading-relaxed max-w-lg mx-auto">
        We've housed working crews ourselves and dealt with every problem — teams who need invoices, accountants who need receipts, people who just need a comfortable bed near the job and somewhere to park. Whether it's a construction crew, a film unit or a business team, we built Crewbase because nothing else was built for this.
      </p>
    </div>
  </div>
</section>

<%# ===== FINAL CTA ===== %>
<section class="bg-slate-50 py-16 border-t border-slate-100">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="bg-[#0F224F] rounded-2xl px-8 py-14 md:px-16 text-center relative overflow-hidden">
      <h2 class="font-headline text-2xl md:text-3xl font-bold text-white mb-3">
        Your crew needs somewhere to stay.<br>Tell us where.
      </h2>
      <p class="text-blue-200/60 max-w-md mx-auto mb-8 text-sm">
        Send the location, dates and numbers. We'll come back within 24 hours — every stay includes a proper invoice.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <%= link_to root_path(anchor: "enquiry"), class: "bg-white text-[#0F224F] px-7 py-3 rounded-xl font-semibold text-sm hover:bg-blue-50 transition-colors" do %>
          Send an enquiry
        <% end %>
        <%= mail_to contact_email, "Email #{contact_email}", subject: "Accommodation enquiry",
            class: "border border-white/25 text-white px-7 py-3 rounded-xl font-semibold text-sm hover:bg-white/10 transition-colors" %>
      </div>
    </div>
  </div>
</section>
