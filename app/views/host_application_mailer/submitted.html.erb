<h1>New host application</h1>

<p><%= @applicant.first_name || @applicant.email.split("@").first %> (<%= @applicant.email %>) has applied to host.</p>

<div class="detail-box">
  <table width="100%" cellpadding="0" cellspacing="0" style="font-size: 14px;">
    <tr>
      <td style="padding: 6px 0; color: #6b7280;">Applicant type</td>
      <td style="padding: 6px 0; color: #111c2d; font-weight: 600; text-align: right;"><%= @application.applicant_type.titleize %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6b7280;">Property address</td>
      <td style="padding: 6px 0; color: #111c2d; font-weight: 600; text-align: right;"><%= @application.property_address %></td>
    </tr>
    <% if @application.company? %>
      <tr>
        <td style="padding: 6px 0; color: #6b7280;">Company</td>
        <td style="padding: 6px 0; color: #111c2d; font-weight: 600; text-align: right;"><%= @application.company_name %> (<%= @application.entity_type&.titleize %>)</td>
      </tr>
    <% end %>
  </table>
</div>

<p><%= link_to "Review the application", admin_host_application_url(@application) %></p>
